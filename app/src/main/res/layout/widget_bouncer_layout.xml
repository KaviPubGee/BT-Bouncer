<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bt_bouncer"
            android:contentDescription="Bouncer Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BT Bouncer"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIP Access • Quick Toggle"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_refresh_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider" />

    <!-- Empty View -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No paired devices found"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Slots Container -->
    <LinearLayout
        android:id="@+id/widget_slots_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- SLOT 1 -->
        <LinearLayout
            android:id="@+id/slot_1_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/slot_1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Device 1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/slot_1_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnected"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/slot_1_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_allowed"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="ON"
                android:textColor="@color/widget_toggle_on_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SLOT 2 -->
        <LinearLayout
            android:id="@+id/slot_2_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/slot_2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Device 2"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/slot_2_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnected"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/slot_2_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_allowed"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="ON"
                android:textColor="@color/widget_toggle_on_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SLOT 3 -->
        <LinearLayout
            android:id="@+id/slot_3_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/slot_3_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Device 3"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/slot_3_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnected"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/slot_3_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_allowed"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="ON"
                android:textColor="@color/widget_toggle_on_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SLOT 4 -->
        <LinearLayout
            android:id="@+id/slot_4_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/slot_4_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Device 4"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/slot_4_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnected"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/slot_4_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_allowed"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="ON"
                android:textColor="@color/widget_toggle_on_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SLOT 5 -->
        <LinearLayout
            android:id="@+id/slot_5_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/slot_5_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Device 5"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/slot_5_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnected"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/slot_5_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_allowed"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="ON"
                android:textColor="@color/widget_toggle_on_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
